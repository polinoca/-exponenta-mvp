FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTHONPATH=/app

WORKDIR /bootstrap
COPY chunks /bootstrap/chunks

RUN python - <<'PY'
import base64, io, tarfile
from pathlib import Path

root = Path("/bootstrap/chunks")
names = ["00", "part-01", "part-02", "part-03", "part-04", "part-05", "part-06"]
parts = [root.joinpath(n).read_text().strip() for n in names]

prefix_len = sum(len(x) for x in parts[:4])
bad = parts[4]
suffix = "".join(parts[5:])
prefix = "".join(parts[:4])

def try_archive(s):
    try:
        raw = base64.b64decode(s, validate=True)
        with tarfile.open(fileobj=io.BytesIO(raw), mode="r:gz") as tf:
            tf.extractall("/app")
        return True
    except Exception:
        return False

full = prefix + bad + suffix
if not try_archive(full):
    fixed = False
    for i in range(len(bad)):
        candidate = prefix + bad[:i] + bad[i+1:] + suffix
        if try_archive(candidate):
            print(f"Recovered archive by removing one corrupt base64 character at part-04 offset {i}")
            fixed = True
            break
    if not fixed:
        raise SystemExit("Could not reconstruct Exponenta source archive")
PY

WORKDIR /app
RUN pip install --no-cache-dir -r requirements.txt \
    && chmod +x /app/scripts/start.sh

EXPOSE 8000
CMD ["/app/scripts/start.sh"]
