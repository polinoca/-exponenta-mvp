# verified source snapshot 2026-09-25
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTHONPATH=/app

WORKDIR /bootstrap
COPY zipchunks /bootstrap/zipchunks
COPY patches /bootstrap/patches

RUN cat /bootstrap/zipchunks/z00 \
        /bootstrap/zipchunks/z01 \
        /bootstrap/zipchunks/z02_0 \
        /bootstrap/zipchunks/z02_1 \
        /bootstrap/zipchunks/z02_2 \
        /bootstrap/zipchunks/z03 \
        /bootstrap/zipchunks/z04 \
        /bootstrap/zipchunks/z05 \
        /bootstrap/zipchunks/z06 \
        /bootstrap/zipchunks/z07_0 \
        /bootstrap/zipchunks/z07_1 \
        /bootstrap/zipchunks/z07_2 \
      > /tmp/exponenta.zip.b64 \
    && base64 -d /tmp/exponenta.zip.b64 > /tmp/exponenta.zip \
    && echo "a2bf14df15b450c4f23023368d5ead6dd1bde6bc0f19d65df41accfd775104cc  /tmp/exponenta.zip" | sha256sum -c - \
    && mkdir -p /app \
    && python - <<'PY'
import zipfile
p = "/tmp/exponenta.zip"
with zipfile.ZipFile(p) as z:
    bad = z.testzip()
    if bad:
        raise SystemExit(f"Corrupt ZIP member: {bad}")
    z.extractall("/app")
PY

RUN python /bootstrap/patches/production_patch.py \
    && python /bootstrap/patches/google_wallet_patch.py \
    && python /bootstrap/patches/landing_commercial_patch.py \
    && python /bootstrap/patches/panel_brand_patch.py \
    && python /bootstrap/patches/billing_patch.py \
    && python /bootstrap/patches/billing_runtime_fix.py \
    && python /bootstrap/patches/stripe_pause_patch.py \
    && python /bootstrap/patches/stripe_checkout_test_patch.py \
    && python /bootstrap/patches/billing_csrf_hotfix.py \
    && python /bootstrap/patches/billing_plan_render_fix.py \
    && python /bootstrap/patches/stripe_checkout_url_fix.py \
    && python /bootstrap/patches/control_center_patch.py \
    && python /bootstrap/patches/plan_templates_patch.py \
    && python /bootstrap/patches/stripe_webhook_fix.py \
    && python /bootstrap/patches/stripe_period_ui_fix.py \
    && python /bootstrap/patches/billing_portal_open_fix.py \
    && python /bootstrap/patches/pro_pricing_ui_patch.py \
    && python /bootstrap/patches/entitlement_ui_patch.py \
    && python /bootstrap/patches/i18n_public_patch.py \
    && python /bootstrap/patches/subscription_switch_patch.py \
    && python /bootstrap/patches/auth_ux_patch.py \
    && python /bootstrap/patches/password_recovery_patch.py \
    && python /bootstrap/patches/admin_password_reset_patch.py \
    && python /bootstrap/patches/mobile_ux_final_patch.py \
    && python /bootstrap/patches/google_wallet_test_mode_patch.py \
    && python /bootstrap/patches/google_wallet_test_accounts_patch.py \
    && python /bootstrap/patches/google_wallet_test_accounts_fix.py \
    && python /bootstrap/patches/google_wallet_helper_signature_fix.py \
    && python /bootstrap/patches/google_wallet_live_sync_patch.py \
    && python /bootstrap/patches/qr_nfc_operator_compat_patch.py \
    && python /bootstrap/patches/universal_password_toggle_patch.py \
    && python /bootstrap/patches/qr_nfc_session_safety_fix.py \
    && python /bootstrap/patches/remove_qr_nfc_middleware_patch.py \
    && python /bootstrap/patches/diagnose_admin_auth_patch.py \
    && python /bootstrap/patches/control_center_auth_fix.py \
    && python /bootstrap/patches/control_center_csrf_fix.py \
    && python /bootstrap/patches/control_center_status_colors.py \
    && python /bootstrap/patches/control_center_high_contrast_toggle.py \
    && python /bootstrap/patches/admin_password_reset_csrf_fix.py \
    && python /bootstrap/patches/admin_password_reset_ux_patch.py \
    && python /bootstrap/patches/admin_password_reset_ux_retry.py \
    && python /bootstrap/patches/admin_password_reset_ux_deploy_fix.py \
    && python /bootstrap/patches/business_logo_upload_format_fix.py \
    && python /bootstrap/patches/business_logo_upload_retry.py \
    && python /bootstrap/patches/business_logo_cache_bust.py \
    && python /bootstrap/patches/campaign_destination_ux_fix.py

WORKDIR /app
RUN test -f /app/app/__init__.py \
    && test -f /app/app/config.py \
    && test -f /app/app/main.py \
    && test -f /app/app/static/exponenta-logo.svg \
    && pip install --no-cache-dir -r requirements.txt \
    && python -m compileall -q /app/app \
    && chmod +x /app/scripts/start.sh

EXPOSE 8000
CMD ["sh", "-c", "cd /app && export PYTHONPATH=/app && python -m alembic -c /app/alembic.ini upgrade head && exec python -m uvicorn app.main:app --app-dir /app --host 0.0.0.0 --port ${PORT:-8000} --proxy-headers --forwarded-allow-ips='*'"]
