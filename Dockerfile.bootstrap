# verified source snapshot 2026-09-25
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTHONPATH=/app

WORKDIR /bootstrap
COPY zipchunks /bootstrap/zipchunks
COPY patches /bootstrap/patches

RUN cat /bootstrap/zipchunks/z00 \
        /bootstrap/zipchunks/z01 \
        /bootstrap/zipchunks/z02_0 \
        /bootstrap/zipchunks/z02_1 \
        /bootstrap/zipchunks/z02_2 \
        /bootstrap/zipchunks/z03 \
        /bootstrap/zipchunks/z04 \
        /bootstrap/zipchunks/z05 \
        /bootstrap/zipchunks/z06 \
        /bootstrap/zipchunks/z07_0 \
        /bootstrap/zipchunks/z07_1 \
        /bootstrap/zipchunks/z07_2 \
      > /tmp/exponenta.zip.b64 \
    && base64 -d /tmp/exponenta.zip.b64 > /tmp/exponenta.zip \
    && echo "a2bf14df15b450c4f23023368d5ead6dd1bde6bc0f19d65df41accfd775104cc  /tmp/exponenta.zip" | sha256sum -c - \
    && mkdir -p /app \
    && python - <<'PY'
import zipfile
p = "/tmp/exponenta.zip"
with zipfile.ZipFile(p) as z:
    bad = z.testzip()
    if bad:
        raise SystemExit(f"Corrupt ZIP member: {bad}")
    z.extractall("/app")
PY

RUN python /bootstrap/patches/production_patch.py \
    && python /bootstrap/patches/google_wallet_patch.py \
    && python /bootstrap/patches/landing_commercial_patch.py \
    && python /bootstrap/patches/panel_brand_patch.py

WORKDIR /app
RUN test -f /app/app/__init__.py \
    && test -f /app/app/config.py \
    && test -f /app/app/main.py \
    && test -f /app/app/static/exponenta-logo.webp \
    && pip install --no-cache-dir -r requirements.txt \
    && python -m compileall -q /app/app \
    && chmod +x /app/scripts/start.sh

EXPOSE 8000
CMD ["sh", "-c", "cd /app && export PYTHONPATH=/app && python -m alembic -c /app/alembic.ini upgrade head && exec python -m uvicorn app.main:app --app-dir /app --host 0.0.0.0 --port ${PORT:-8000} --proxy-headers --forwarded-allow-ips='*'"]
